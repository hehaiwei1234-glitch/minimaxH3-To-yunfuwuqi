+# The app writes its own NG diagnosis into clip['redo_feedback'] on every automatic retry. In draft mode no
+# language model rewrites the prompt, so H3 used to receive that Chinese note verbatim inside the video prompt:
+# it read the note aloud as garbled speech *before* the scripted line, pushed the real line toward the end of
+# the clip (where it was cut) and acted on the note. Only feedback a person typed may reach the models.
+AUTO_DIAGNOSTIC_PREFIXES = ('修正视频/对白核对发现的问题',)
+
+def user_feedback(clip):
+    text = str(clip.get('redo_feedback') or '').strip()
+    return '' if text.startswith(AUTO_DIAGNOSTIC_PREFIXES) else text
